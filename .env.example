# Copy to .env and fill in from your Supabase project (Settings -> API).
# This is the same project the web app in `concard` uses.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional. Public origin encoded into QR codes and share links.
# Defaults to https://concard.me.
EXPO_PUBLIC_SITE_URL=https://concard.me
